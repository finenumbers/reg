# Copy to .env and fill in real values. Never commit secrets.
#
# Generate secrets:
#   openssl rand -base64 32   → BETTER_AUTH_SECRET
#   openssl rand -hex 32      → APP_ENCRYPTION_KEY
#
# Production: BETTER_AUTH_URL must be the public HTTPS origin (NPM host).
# Auto-poll is Settings-only (regsPollEnabled). v1 assumes exactly one `app` container.

NODE_ENV=development

# PostgreSQL — local `npm run dev` (host → published db port)
DATABASE_URL=postgresql://reg:reg@localhost:5432/reg?schema=public

# Optional compose DB credentials (app container always uses host `db`)
POSTGRES_USER=reg
POSTGRES_PASSWORD=reg
POSTGRES_DB=reg
# POSTGRES_PUBLISH_PORT=5432
# APP_PUBLISH_PORT=3000

# Better Auth (generate secret: openssl rand -base64 32)
# Min 32 chars. Production rejects placeholders like "change-me".
BETTER_AUTH_SECRET=change-me-to-a-long-random-secret-at-least-32-chars
# Public origin browsers use (behind NPM: https://regs.example.com)
BETTER_AUTH_URL=http://localhost:3000

# AES-256-GCM master key: exactly 32 bytes as 64 hex chars
# openssl rand -hex 32
# REQUIRED to decrypt stored SSH private keys — back this up with the database.
# Production rejects the example key below; replace before go-live.
APP_ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# Bootstrap first admin (idempotent). Used by db:seed, bootstrap:admin, and app startup.
# Creates the user only when the users table is empty; if the username exists, ensures admin role.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-admin-password
# Optional display name (defaults to username)
# ADMIN_DISPLAY_NAME=Platform Admin

# Optional: CDR enrich artifacts (default: ./data/enrich)
# ENRICH_DATA_DIR=/app/data/enrich

# Docker: schema migrations run via the compose `migrate` service before `app` starts.
# Host one-shot: ./scripts/db-migrate.sh  (or: npx prisma migrate deploy)
