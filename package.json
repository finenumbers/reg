{
  "name": "reg-platform",
  "version": "1.6.2",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "format": "prettier --write .",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:push": "prisma db push",
    "db:seed": "npx tsx prisma/seed.ts",
    "db:studio": "prisma studio",
    "bootstrap:admin": "npx tsx scripts/bootstrap-admin.ts",
    "db:migrate:deploy": "npx prisma migrate deploy",
    "smoke": "bash scripts/smoke-check.sh",
    "backup:db": "bash scripts/backup-db.sh",
    "test": "vitest run",
    "test:watch": "vitest",
    "auth:generate": "npx @better-auth/cli@latest generate --config src/modules/auth/auth.ts --yes --output prisma/schema.prisma && prisma generate"
  },
  "prisma": {
    "seed": "npx tsx prisma/seed.ts"
  },
  "dependencies": {
    "@better-auth/prisma-adapter": "^1.6.26",
    "@prisma/adapter-pg": "^7.9.1",
    "@prisma/client": "^7.9.1",
    "better-auth": "^1.6.26",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dotenv": "^17.4.2",
    "exceljs": "^4.4.0",
    "ftp-srv": "^4.6.3",
    "lucide-react": "^1.28.0",
    "next": "16.3.0",
    "p-queue": "^9.3.3",
    "pg": "^8.22.0",
    "ppk-to-openssh": "^3.2.0",
    "radix-ui": "^1.6.7",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "sonner": "^2.0.7",
    "ssh2": "^1.17.0",
    "sshpk": "^1.18.0",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/ssh2": "^1.15.5",
    "@types/sshpk": "^1.17.5",
    "eslint": "^9",
    "eslint-config-next": "16.3.0",
    "prettier": "^3.9.6",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "prisma": "^7.9.1",
    "shadcn": "^4.16.1",
    "tailwindcss": "^4",
    "tsx": "^4.23.9",
    "typescript": "^5",
    "vitest": "^3.2.4"
  }
