// Prisma schema — SIP Registration Platform
//
// AUTH MODELS: source of truth = Better Auth official adapter/CLI.
// Generate / refresh with:
//   npx @better-auth/cli@latest generate --yes
// Do not invent custom auth table names. App domain models live below.
// After generation, commit the merged schema.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// Better Auth models are inserted by CLI generate (do not hand-author here).
// ---------------------------------------------------------------------------

// ---------------------------------------------------------------------------
// RBAC (app-owned, layered on Better Auth user id)
// ---------------------------------------------------------------------------

model Role {
  id          String           @id @default(cuid())
  name        String           @unique
  description String?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  users       UserRole[]
  permissions RolePermission[]

  @@map("roles")
}

model Permission {
  id          String           @id @default(cuid())
  code        String           @unique
  description String?
  roles       RolePermission[]

  @@map("permissions")
}

model UserRole {
  id     String @id @default(cuid())
  userId String
  roleId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  role   Role   @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([userId, roleId])
  @@index([userId])
  @@map("user_roles")
}

model RolePermission {
  id           String     @id @default(cuid())
  roleId       String
  permissionId String
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([roleId, permissionId])
  @@map("role_permissions")
}

// ---------------------------------------------------------------------------
// Settings / SSH
// ---------------------------------------------------------------------------

model SshProfile {
  id                   String              @id @default(cuid())
  name                 String
  host                 String
  port                 Int                 @default(22)
  username             String
  /// AES-256-GCM ciphertext of normalized OpenSSH/PEM private key. Never plaintext.
  privateKeyCiphertext String?
  keyFingerprint       String?
  keyAlgo              String?
  createdAt            DateTime            @default(now())
  updatedAt            DateTime            @updatedAt
  appSettings          AppSetting[]
  connectionTests      SshConnectionTest[]

  @@map("ssh_profiles")
}

model AppSetting {
  id                    Int         @id @default(1)
  activeSshProfileId    String?
  activeSshProfile      SshProfile? @relation(fields: [activeSshProfileId], references: [id])
  regsPollEnabled       Boolean     @default(false)
  /// Technical floor enforced in validation (>= 30 recommended).
  regsPollIntervalSec   Int         @default(60)
  /// Phones + groups (export.py), independent of regs.poll.
  exportSyncEnabled     Boolean     @default(false)
  exportSyncIntervalSec Int         @default(300)
  /// Backfill cdr_records.side_* from the phones catalog (diff-only).
  cdrSidesRefreshEnabled     Boolean @default(true)
  cdrSidesRefreshIntervalSec Int     @default(300)
  /// Last successfully applied phone → Описание map (JSON object).
  cdrSidesRefreshMap         Json?
  /// phone_import_state.lastSyncedAt used when the map was saved.
  cdrSidesRefreshCatalogAt   DateTime?
  artifactRetentionDays Int         @default(14)
  artifactKeepLastRuns  Int         @default(50)
  artifactMaxBytes      Int         @default(50000000)
  /// Origin of GeoIP Analytics (no trailing slash). Empty → DEFAULT_GEOIP_BASE_URL.
  geoipBaseUrl          String?     @default("https://geoip.finenumbers.com")
  /// AES-256-GCM ciphertext of External IP Lookup API key. Never plaintext.
  geoipApiKeyCiphertext String?
  /// IANA zone for all operator-facing clocks (UI + XLSX).
  displayTimezone       String      @default("Europe/Moscow")
  /// Origin of PSTN Analytics lookup (no trailing slash). Empty → DEFAULT_PSTN_BASE_URL.
  pstnBaseUrl           String?     @default("https://pstn.finenumbers.com")
  /// AES-256-GCM ciphertext of PSTN External Lookup API key. Never plaintext.
  pstnApiKeyCiphertext  String?
  /// In-process FTP listener for softswitch CDR uploads.
  ftpEnabled            Boolean     @default(false)
  ftpUsername           String?
  /// AES-256-GCM ciphertext of FTP password. Never plaintext.
  ftpPasswordCiphertext String?
  ftpListenPort         Int         @default(2121)
  ftpPasvMinPort        Int         @default(50100)
  ftpPasvMaxPort        Int         @default(50109)
  /// Optional PASV advertise address — unused when the softswitch uses active FTP.
  ftpPasvAddress        String?
  /// In-process FTP listener for Eltex SMG CDR uploads.
  smgFtpEnabled            Boolean @default(false)
  smgFtpUsername           String?
  /// AES-256-GCM ciphertext of the SMG FTP password. Never plaintext.
  smgFtpPasswordCiphertext String?
  smgFtpListenPort         Int     @default(2122)
  smgFtpPasvMinPort        Int     @default(50110)
  smgFtpPasvMaxPort        Int     @default(50119)
  /// Optional PASV advertise address — unused when the gateway uses active FTP.
  smgFtpPasvAddress        String?
  /// VoIPmonitor WEB API correlation (independent of Collector).
  voipmonitorEnabled              Boolean @default(false)
  voipmonitorApiUrl               String?
  voipmonitorUser                 String?
  voipmonitorPasswordCiphertext   String?
  voipmonitorGuiUrl               String?
  /// UDP syslog receiver for registered SMG nodes. Off until an operator enables it.
  syslogEnabled                   Boolean  @default(false) @map("syslog_enabled")
  updatedAt             DateTime    @updatedAt

  @@map("app_settings")
}

/// Eltex SMG allowed to send syslog. The ip is the UDP source address.
model SmgSyslogNode {
  ip         String   @id
  name       String   @unique
  /// Stable variable for later use. Null until the operator sets it.
  identifier String?  @unique
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  @@map("smg_syslog_nodes")
}

// ---------------------------------------------------------------------------
// Allowed actions (code-owned allowlist reflection; remote_path not editable via API)
// ---------------------------------------------------------------------------

model AllowedAction {
  code        String   @id
  remotePath  String
  description String?
  enabled     Boolean  @default(true)
  module      String
  jobRuns     JobRun[]

  @@map("allowed_actions")
}

// ---------------------------------------------------------------------------
// Jobs
// ---------------------------------------------------------------------------

enum JobTrigger {
  schedule
  manual
  test
}

enum JobStatus {
  running
  success
  failed
}

model JobRun {
  id              String                @id @default(cuid())
  actionCode      String
  action          AllowedAction         @relation(fields: [actionCode], references: [code])
  trigger         JobTrigger
  status          JobStatus
  startedAt       DateTime              @default(now())
  finishedAt      DateTime?
  durationMs      Int?
  errorMessage    String?
  exitCode        Int?
  phonesParsed    Int?
  linesBad        Int?
  changesCount    Int?
  meta            Json?
  actorUserId     String?
  artifact        JobRunArtifact?
  regCurrents     RegistrationCurrent[]
  regEvents       RegistrationEvent[]
  phoneEndpoints  PhoneEndpoint[]
  phoneGateways   PhoneGateway[]
  routingGroups   RoutingGroup[]
  connectionTests SshConnectionTest[]
  cdrRecords      CdrRecord[]
  smgCdrRecords   SmgCdrRecord[]

  @@index([actionCode, startedAt(sort: Desc)])
  @@index([status, startedAt(sort: Desc)])
  @@index([startedAt])
  @@map("job_runs")
}

model JobRunArtifact {
  jobRunId String @id
  jobRun   JobRun @relation(fields: [jobRunId], references: [id], onDelete: Cascade)
  stdout   String
  stderr   String

  @@map("job_run_artifacts")
}

enum SshTestResult {
  success
  auth_error
  timeout
  error
}

model SshConnectionTest {
  id          String        @id @default(cuid())
  profileId   String
  profile     SshProfile    @relation(fields: [profileId], references: [id], onDelete: Cascade)
  actorUserId String?
  result      SshTestResult
  detail      String?
  exitCode    Int?
  parsedCount Int?
  jobRunId    String?
  jobRun      JobRun?       @relation(fields: [jobRunId], references: [id])
  createdAt   DateTime      @default(now())

  @@index([profileId, createdAt(sort: Desc)])
  @@index([jobRunId])
  @@map("ssh_connection_tests")
}

// ---------------------------------------------------------------------------
// Audit
// ---------------------------------------------------------------------------

model AuditLog {
  id          String   @id @default(cuid())
  actorUserId String?
  action      String
  entityType  String?
  entityId    String?
  meta        Json?
  ip          String?
  createdAt   DateTime @default(now())

  @@index([createdAt(sort: Desc)])
  @@index([actorUserId, createdAt(sort: Desc)])
  @@map("audit_logs")
}

// ---------------------------------------------------------------------------
// Registrations module
// ---------------------------------------------------------------------------

enum RegStatus {
  Registered
  Unregistered
}

model RegistrationCurrent {
  phone         String    @id
  status        RegStatus
  ip            String?
  port          Int?
  lastSeenAt    DateTime
  lastChangedAt DateTime
  lastJobRunId  String?
  lastJobRun    JobRun?   @relation(fields: [lastJobRunId], references: [id])
  updatedAt     DateTime  @updatedAt

  @@index([status])
  @@index([lastChangedAt(sort: Desc)])
  @@index([lastJobRunId])
  @@map("reg_current")
}

model RegistrationEvent {
  id        String     @id @default(cuid())
  phone     String
  oldStatus RegStatus?
  newStatus RegStatus
  oldIp     String?
  newIp     String?
  oldPort   Int?
  newPort   Int?
  changedAt DateTime   @default(now())
  jobRunId  String?
  jobRun    JobRun?    @relation(fields: [jobRunId], references: [id])

  @@index([phone, changedAt(sort: Desc)])
  @@index([jobRunId])
  @@map("reg_change_events")
}

/// Cached GRCHC lookup (country / city / ASN org) keyed by registration IPv4.
model IpGeoCache {
  ip          String   @id
  country     String?
  /// ISO 3166-1 alpha-2 from GeoIP country.countryIsoCode (enrich).
  countryIso  String?
  city        String?
  isp         String?
  datasetDate String?
  lookedUpAt  DateTime
  updatedAt   DateTime @updatedAt

  @@index([lookedUpAt])
  @@map("ip_geo_cache")
}

/// Cached PSTN Analytics lookup (operator / GAR territory) keyed by 10-digit phone.
model PstnPhoneCache {
  phone        String   @id
  found        Boolean
  operator     String?
  garTerritory String?
  lookedUpAt   DateTime
  updatedAt    DateTime @updatedAt

  @@index([lookedUpAt])
  @@map("pstn_phone_cache")
}

enum EnrichJobStatus {
  queued
  running
  completed
  failed
}

/// Ephemeral CDR enrich run. Artifact paths are derived from id, not stored.
/// At most one queued|running row — partial unique index enrich_jobs_one_active.
model EnrichJob {
  id             String          @id @default(cuid())
  status         EnrichJobStatus
  actorUserId    String?
  sourceFilename String
  stages         Json
  summary        Json?
  errorMessage   String?
  createdAt      DateTime        @default(now())
  startedAt      DateTime?
  finishedAt     DateTime?
  updatedAt      DateTime        @updatedAt

  @@index([status, createdAt(sort: Desc)])
  @@index([actorUserId, createdAt(sort: Desc)])
  @@map("enrich_jobs")
}

// ---------------------------------------------------------------------------
// Phones module (export.py JSON → local snapshot)
// ---------------------------------------------------------------------------

model PhoneEndpoint {
  id             String   @id @default(cuid())
  /// gateway_name from softswitch
  name           String
  endpointNumber String?
  /// Full row keyed by Russian Excel headers (incl. plaintext password)
  data           Json
  lastSyncedAt   DateTime
  lastJobRunId   String?
  lastJobRun     JobRun?  @relation(fields: [lastJobRunId], references: [id], onDelete: SetNull)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([name])
  @@index([endpointNumber])
  @@index([lastSyncedAt(sort: Desc)])
  @@index([lastJobRunId])
  @@map("phone_endpoints")
}

model PhoneGateway {
  id           String   @id @default(cuid())
  name         String
  /// Full row keyed by Russian Excel headers
  data         Json
  lastSyncedAt DateTime
  lastJobRunId String?
  lastJobRun   JobRun?  @relation(fields: [lastJobRunId], references: [id], onDelete: SetNull)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([name])
  @@index([lastSyncedAt(sort: Desc)])
  @@index([lastJobRunId])
  @@map("phone_gateways")
}

model PhoneImportState {
  id                Int       @id @default(1)
  endpointCount     Int       @default(0)
  gatewayCount      Int       @default(0)
  /// string[] headers for endpoints table
  headersEndpoints  Json      @default("[]")
  /// string[] headers for gateways table
  headersGateways   Json      @default("[]")
  lastSyncedAt      DateTime?
  lastJobRunId      String?
  updatedAt         DateTime  @updatedAt

  @@map("phone_import_state")
}

/// Softswitch routing groups catalog (snapshot from export.py groups[]).
model RoutingGroup {
  id           String   @id @default(cuid())
  /// routing_group_id from softswitch
  externalId   String   @unique
  /// routing_group_name
  name         String   @unique
  sortOrder    Int      @default(0)
  lastSyncedAt DateTime
  lastJobRunId String?
  lastJobRun   JobRun?  @relation(fields: [lastJobRunId], references: [id], onDelete: SetNull)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([sortOrder])
  @@index([lastJobRunId])
  @@map("routing_groups")
}

model RoutingGroupImportState {
  id           Int       @id @default(1)
  groupCount   Int       @default(0)
  lastSyncedAt DateTime?
  lastJobRunId String?
  updatedAt    DateTime  @updatedAt

  @@map("routing_group_import_state")
}

/// Tariff snapshot from an uploaded XLSX. Each import replaces every row.
model TariffRate {
  id        String  @id @default(cuid())
  /// Order in the uploaded file (empty rows omitted).
  sortIndex Int
  direction String
  /// Digit fragment of a phone number. Text so a leading zero survives.
  abc       String
  /// Dialed lengths joined by "/". Null when the cell is empty and for every ABC that starts with 7.
  /// An empty string matches no length. Prisma cannot store a nullable integer list.
  digitLengths String?
  price     Decimal @db.Decimal(18, 6)

  @@unique([sortIndex])
  @@index([abc])
  @@index([direction])
  @@map("tariff_rates")
}

/// Digit ABC that marks an uncovered B-number as «Ошибка» / «Проверить».
/// `*` and `#` are not rows: those symbols are a fixed rule in the rater.
model DialException {
  /// Same shape as a tariff ABC: digits, length 1–15. Text so a leading zero survives.
  abc       String   @id
  createdAt DateTime @default(now())

  @@map("dial_exceptions")
}

model TariffImportState {
  id              Int       @id @default(1)
  rowCount        Int       @default(0)
  filename        String?
  loadedAt        DateTime?
  /// Incremented in the same transaction as a successful snapshot replace.
  rateGeneration  Int       @default(0)
  /// Set to rateGeneration only after a full CDR pass for that generation.
  ratedGeneration Int       @default(0)
  updatedAt       DateTime  @updatedAt

  @@map("tariff_import_state")
}

// ---------------------------------------------------------------------------
// Phone traffic (full softswitch CDR dump)
// ---------------------------------------------------------------------------

model CdrRecord {
  id                         String    @id @default(cuid())
  cdrAt                      DateTime?
  cdrId                      String    @unique @map("cdr_id")
  cdrDate                    String    @map("cdr_date")
  cdrDay                     String    @default("") @map("cdr_day")
  cdrTime                    String    @default("") @map("cdr_time")
  inAni                      String    @map("in_ani")
  inDnis                     String    @map("in_dnis")
  outAni                     String    @map("out_ani")
  outDnis                    String    @map("out_dnis")
  billAni                    String    @map("bill_ani")
  billDnis                   String    @map("bill_dnis")
  sigNodeName                String    @map("sig_node_name")
  srcGatekeeperAddress       String    @map("src_gatekeeper_address")
  remoteSrcSigAddress        String    @map("remote_src_sig_address")
  remoteDstSigAddress        String    @map("remote_dst_sig_address")
  remoteSrcMediaAddress      String    @map("remote_src_media_address")
  remoteDstMediaAddress      String    @map("remote_dst_media_address")
  localSrcSigAddress         String    @map("local_src_sig_address")
  localDstSigAddress         String    @map("local_dst_sig_address")
  localSrcMediaAddress       String    @map("local_src_media_address")
  localDstMediaAddress       String    @map("local_dst_media_address")
  inLegProto                 String    @map("in_leg_proto")
  outLegProto                String    @map("out_leg_proto")
  confId                     String    @map("conf_id")
  inLegCallId                String    @map("in_leg_call_id")
  outLegCallId               String    @map("out_leg_call_id")
  srcUser                    String    @map("src_user")
  dstUser                    String    @map("dst_user")
  radiusUser                 String    @map("radius_user")
  srcName                    String    @map("src_name")
  dstName                    String    @map("dst_name")
  dpName                     String    @map("dp_name")
  elapsedTime                String    @map("elapsed_time")
  setupTime                  String    @map("setup_time")
  connectTime                String    @map("connect_time")
  disconnectTime             String    @map("disconnect_time")
  inLegCodecs                String    @map("in_leg_codecs")
  outLegCodecs               String    @map("out_leg_codecs")
  srcFaststartPresent        String    @map("src_faststart_present")
  dstFaststartPresent        String    @map("dst_faststart_present")
  srcTunnelingPresent        String    @map("src_tunneling_present")
  dstTunnelingPresent        String    @map("dst_tunneling_present")
  proxyMode                  String    @map("proxy_mode")
  larFaultReason             String    @map("lar_fault_reason")
  routeRetries               String    @map("route_retries")
  scd                        String    @map("scd")
  pdd                        String    @map("pdd")
  mediaGroup                 String    @map("media_group")
  srcMediaBytesIn            String    @map("src_media_bytes_in")
  srcMediaBytesOut           String    @map("src_media_bytes_out")
  dstMediaBytesIn            String    @map("dst_media_bytes_in")
  dstMediaBytesOut           String    @map("dst_media_bytes_out")
  srcMediaPackets            String    @map("src_media_packets")
  dstMediaPackets            String    @map("dst_media_packets")
  srcMediaPacketsLate        String    @map("src_media_packets_late")
  dstMediaPacketsLate        String    @map("dst_media_packets_late")
  srcMediaPacketsLost        String    @map("src_media_packets_lost")
  dstMediaPacketsLost        String    @map("dst_media_packets_lost")
  srcMinJitterSize           String    @map("src_min_jitter_size")
  srcMaxJitterSize           String    @map("src_max_jitter_size")
  dstMinJitterSize           String    @map("dst_min_jitter_size")
  dstMaxJitterSize           String    @map("dst_max_jitter_size")
  lastCdr                    String    @map("last_cdr")
  inCpc                      String    @map("in_cpc")
  outCpc                     String    @map("out_cpc")
  inZone                     String    @map("in_zone")
  outZone                    String    @map("out_zone")
  disconnectInitiator        String    @map("disconnect_initiator")
  inAniTypeOfNumber          String    @map("in_ani_type_of_number")
  inDnisTypeOfNumber         String    @map("in_dnis_type_of_number")
  outAniTypeOfNumber         String    @map("out_ani_type_of_number")
  outDnisTypeOfNumber        String    @map("out_dnis_type_of_number")
  srcInLegConfId             String    @map("src_in_leg_conf_id")
  srcInLegCallId             String    @map("src_in_leg_call_id")
  srcOutLegCallId            String    @map("src_out_leg_call_id")
  inOrigDnis                 String    @map("in_orig_dnis")
  outOrigDnis                String    @map("out_orig_dnis")
  recordType                 String    @map("record_type")
  extradata                  String    @map("extradata")
  termElapsedTime            String    @map("term_elapsed_time")
  termSetupTime              String    @map("term_setup_time")
  termConnectTime            String    @map("term_connect_time")
  termDisconnectTime         String    @map("term_disconnect_time")
  termScd                    String    @map("term_scd")
  termPdd                    String    @map("term_pdd")
  externalRouter             String    @map("external_router")
  radiusGroup                String    @map("radius_group")
  inAniScreening             String    @map("in_ani_screening")
  inAniPresentation          String    @map("in_ani_presentation")
  outAniScreening            String    @map("out_ani_screening")
  outAniPresentation         String    @map("out_ani_presentation")
  outgoingPulses             String    @map("outgoing_pulses")
  incomingPulses             String    @map("incoming_pulses")
  inLrn                      String    @map("in_lrn")
  retrievedLrn               String    @map("retrieved_lrn")
  lrn                        String    @map("lrn")
  extLrn                     String    @map("ext_lrn")
  outLrn                     String    @map("out_lrn")
  lnpServer                  String    @map("lnp_server")
  inLegTransportProto        String    @map("in_leg_transport_proto")
  outLegTransportProto       String    @map("out_leg_transport_proto")
  sipRoutingGroup            String    @map("sip_routing_group")
  loopingCycles              String    @map("looping_cycles")
  authDnis                   String    @map("auth_dnis")
  extAni                     String    @map("ext_ani")
  extDnis                    String    @map("ext_dnis")
  extSigAddress              String    @map("ext_sig_address")
  inPartnerId                String    @map("in_partner_id")
  outPartnerId               String    @map("out_partner_id")
  disconnectCodeString       String    @map("disconnect_code_string")
  disconnectCodeSuccess      String    @map("disconnect_code_success")
  srcDisconnectCodesString   String    @map("src_disconnect_codes_string")
  dstDisconnectCodesString   String    @map("dst_disconnect_codes_string")
  inOrigDnisTypeOfNumber     String    @map("in_orig_dnis_type_of_number")
  outOrigDnisTypeOfNumber    String    @map("out_orig_dnis_type_of_number")
  inEncryption               String    @map("in_encryption")
  outEncryption              String    @map("out_encryption")
  extAniTypeOfNumber         String    @map("ext_ani_type_of_number")
  extDnisTypeOfNumber        String    @map("ext_dnis_type_of_number")
  extOrigDnisTypeOfNumber    String    @map("ext_orig_dnis_type_of_number")
  srcDisconnectCodes         String    @map("src_disconnect_codes")
  dstDisconnectCodes         String    @map("dst_disconnect_codes")
  disconnectCode             String    @map("disconnect_code")
  sideA                      String    @default("") @map("side_a")
  operatorA                  String    @default("") @map("operator_a")
  geographyA                 String    @default("") @map("geography_a")
  sideB                      String    @default("") @map("side_b")
  operatorB                  String    @default("") @map("operator_b")
  geographyB                 String    @default("") @map("geography_b")
  countryA                   String    @default("") @map("country_a")
  cityA                      String    @default("") @map("city_a")
  providerA                  String    @default("") @map("provider_a")
  countryB                   String    @default("") @map("country_b")
  cityB                      String    @default("") @map("city_b")
  providerB                  String    @default("") @map("provider_b")
  callCategory               String    @default("") @map("call_category")
  callType                   String    @default("") @map("call_type")
  callStatus                 String    @default("") @map("call_status")
  tariffDirection            String    @default("") @map("tariff_direction")
  tariffCharge               String    @default("") @map("tariff_charge")
  /// Catalog per-minute price (formatTariffDecimal). Not shown on raw or traffic screens.
  tariffPrice                String    @default("") @map("tariff_price")
  enrichedAt                 DateTime? @map("enriched_at")
  sourceFilename             String
  importedAt                 DateTime  @default(now())
  lastJobRunId               String?
  lastJobRun                 JobRun?   @relation(fields: [lastJobRunId], references: [id], onDelete: SetNull)
  voipmonitorLink            CdrVoipmonitorLink?

  @@index([cdrAt(sort: Desc)])
  @@index([cdrDate, cdrId])
  @@index([cdrDay])
  @@index([inAni])
  @@index([inDnis])
  @@index([outAni])
  @@index([outDnis])
  @@index([srcName])
  @@index([dstName])
  @@index([disconnectCodeString])
  @@index([lastJobRunId])
  @@map("cdr_records")
}

model CdrVoipmonitorLink {
  cdrRecordId        String    @id @map("cdr_record_id")
  cdrRecord          CdrRecord @relation(fields: [cdrRecordId], references: [id], onDelete: Cascade)
  voipmonitorUrl     String    @default("") @map("voipmonitor_url")
  voipmonitorCdrId   String    @default("") @map("voipmonitor_cdr_id")
  voipmonitorCallId  String    @default("") @map("voipmonitor_call_id")
  voipmonitorLegs    Json?     @map("voipmonitor_legs")
  matchStatus        String    @default("") @map("match_status")
  matchMethod        String    @default("") @map("match_method")
  matchScore         Int       @default(0) @map("match_score")
  matchedAt          DateTime? @map("matched_at")
  attemptCount       Int       @default(0) @map("attempt_count")
  nextAttemptAt      DateTime? @map("next_attempt_at")
  evidenceJson       String    @default("") @map("evidence_json")
  updatedAt          DateTime  @updatedAt @map("updated_at")

  @@index([matchStatus, nextAttemptAt])
  @@map("cdr_voipmonitor_links")
}

// ---------------------------------------------------------------------------
// Machine API keys (read-only integrations)
// ---------------------------------------------------------------------------

model ApiKey {
  id              String    @id @default(cuid())
  name            String
  /// First characters of the secret (e.g. reg_xxxx…) for UI + lookup.
  keyPrefix       String    @unique
  /// SHA-256 hex of the full secret. Plaintext is never stored.
  keyHash         String
  /// Fixed permission codes JSON array, e.g. ["regs:read","phones:read"].
  permissions     Json
  enabled         Boolean   @default(true)
  createdAt       DateTime  @default(now())
  revokedAt       DateTime?
  lastUsedAt      DateTime?
  createdByUserId String?

  @@index([enabled])
  @@map("api_keys")
}

model User {
  id              String    @id
  name            String
  email           String
  emailVerified   Boolean   @default(false)
  image           String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  username        String?
  displayUsername String?
  isActive        Boolean?  @default(true)
  sessions        Session[]
  accounts        Account[]
  roles           UserRole[]

  @@unique([email])
  @@unique([username])
  @@map("user")
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([token])
  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
  @@map("account")
}

// ---------------------------------------------------------------------------
// Eltex SMG-1016M CDR (separate from softswitch cdr_records)
// ---------------------------------------------------------------------------

model SmgCdrRecord {
  id                        String   @id @default(cuid())
  recordKey                 String   @unique @map("record_key")
  disconnectDay             String   @default("") @map("disconnect_day")
  deviceSign                String   @default("") @map("device_sign")
  setupTime                 String   @default("") @map("setup_time")
  connectTime               String   @default("") @map("connect_time")
  disconnectTime            String   @default("") @map("disconnect_time")
  duration                  String   @default("")
  releaseCause              String   @default("") @map("release_cause")
  callReleaseInfo           String   @default("") @map("call_release_info")
  incomingIp                String   @default("") @map("incoming_ip")
  incomingType              String   @default("") @map("incoming_type")
  incomingDescription       String   @default("") @map("incoming_description")
  outgoingIp                String   @default("") @map("outgoing_ip")
  outgoingType              String   @default("") @map("outgoing_type")
  outgoingDescription       String   @default("") @map("outgoing_description")
  incomingCgpn              String   @default("") @map("incoming_cgpn")
  outgoingCgpn              String   @default("") @map("outgoing_cgpn")
  incomingCdpn              String   @default("") @map("incoming_cdpn")
  outgoingCdpn              String   @default("") @map("outgoing_cdpn")
  redirectingMark           String   @default("") @map("redirecting_mark")
  pickupMark                String   @default("") @map("pickup_mark")
  releaseSideMark           String   @default("") @map("release_side_mark")
  incomingSs7Cic            String   @default("") @map("incoming_ss7_cic")
  incomingSipCallId         String   @default("") @map("incoming_sip_call_id")
  outgoingSs7Cic            String   @default("") @map("outgoing_ss7_cic")
  outgoingSipCallId         String   @default("") @map("outgoing_sip_call_id")
  incomingSs7Category       String   @default("") @map("incoming_ss7_category")
  incomingCidCategory       String   @default("") @map("incoming_cid_category")
  outgoingSs7Category       String   @default("") @map("outgoing_ss7_category")
  outgoingCidCategory       String   @default("") @map("outgoing_cid_category")
  incomingE1Stream          String   @default("") @map("incoming_e1_stream")
  incomingE1Channel         String   @default("") @map("incoming_e1_channel")
  outgoingE1Stream          String   @default("") @map("outgoing_e1_stream")
  outgoingE1Channel         String   @default("") @map("outgoing_e1_channel")
  sequenceNumber            String   @default("") @map("sequence_number")
  incomingRedirectingNumber String   @default("") @map("incoming_redirecting_number")
  outgoingRedirectingNumber String   @default("") @map("outgoing_redirecting_number")
  radiusSessionId           String   @default("") @map("radius_session_id")
  globalCallref             String   @default("") @map("global_callref")
  incomingNumplan           String   @default("") @map("incoming_numplan")
  outgoingNumplan           String   @default("") @map("outgoing_numplan")
  uniqueTag                 String   @default("") @map("unique_tag")
  callingNai                String   @default("") @map("calling_nai")
  calledNai                 String   @default("") @map("called_nai")
  incomingRedirectingNai    String   @default("") @map("incoming_redirecting_nai")
  outgoingRedirectingNai    String   @default("") @map("outgoing_redirecting_nai")
  callTransferMark          String   @default("") @map("call_transfer_mark")
  callRecordPath            String   @default("") @map("call_record_path")
  ivrCallRecordPath         String   @default("") @map("ivr_call_record_path")
  rejectingRadiusAddress    String   @default("") @map("rejecting_radius_address")
  callingNaiOriginal        String   @default("") @map("calling_nai_original")
  calledNaiOriginal         String   @default("") @map("called_nai_original")
  timeInQueue               String   @default("") @map("time_in_queue")
  redirectionType           String   @default("") @map("redirection_type")
  sourceFilename            String   @default("") @map("source_filename")
  importedAt                DateTime @default(now()) @map("imported_at")
  lastJobRunId              String?  @map("last_job_run_id")
  lastJobRun                JobRun?  @relation(fields: [lastJobRunId], references: [id], onDelete: SetNull)

  @@index([disconnectDay])
  @@index([disconnectTime(sort: Desc), id(sort: Desc)])
  @@index([deviceSign, disconnectTime(sort: Desc), id(sort: Desc)])
  @@index([incomingCgpn])
  @@index([outgoingCgpn])
  @@index([incomingCdpn])
  @@index([outgoingCdpn])
  @@index([lastJobRunId])
  @@map("smg_cdr_records")
}

// Syslog call card. The CDR row is not rewritten. One card per gateway IP and UniqueTag.
model SmgCallTrace {
  id        String   @id @default(cuid())
  deviceIp  String   @map("device_ip")
  tagNorm   String   @map("tag_norm")
  callref   String   @default("")
  open       Boolean  @default(true)
  blocks     Json
  afCategory String?  @map("af_category")
  afStatus   String?  @map("af_status")
  updatedAt  DateTime @updatedAt @map("updated_at")

  @@unique([deviceIp, tagNorm])
  @@index([tagNorm])
  @@map("smg_call_traces")
}

// Assembler state after one gzip, so the next file continues open callrefs.
model SmgTraceCheckpoint {
  id       String @id @default(cuid())
  deviceIp String @map("device_ip")
  fileKey  String @map("file_key")
  size     Int
  version  Int
  state    Json

  @@unique([deviceIp, fileKey])
  @@map("smg_trace_checkpoints")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}
